local.file_match "auth_service_logs" {
  path_targets = [
    {
      __path__ = "/logs/*.log",
      service  = "auth-service",
      job      = "careeros",
    },
  ]
}

loki.source.file "auth_service_logs" {
  targets    = local.file_match.auth_service_logs.targets
  forward_to = [loki.write.careeros.receiver]
}

loki.write "careeros" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}