# =============================================================================
# CareerOS — Complete Environment Configuration
# =============================================================================
# IMPORTANT: Never commit this file to git. Keep in .gitignore.
# Copy this to .env and fill in your actual values.
# =============================================================================

# ─────────────────────────────────────────────
# PROJECT
# ─────────────────────────────────────────────
COMPOSE_PROJECT_NAME=careeros
DOCKER_NETWORK=careeros-network

# ─────────────────────────────────────────────
# POSTGRESQL
# ─────────────────────────────────────────────
POSTGRES_DB=careeros
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5433

# ─────────────────────────────────────────────
# PGADMIN
# ─────────────────────────────────────────────
PGADMIN_EMAIL=admin@careeros.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_HOST_PORT=6379
REDIS_PASSWORD=redis123

# ─────────────────────────────────────────────
# KAFKA
# ─────────────────────────────────────────────
KAFKA_HOST_PORT=9092
KAFKA_UI_PORT=8085

# ─────────────────────────────────────────────
# RABBITMQ
# ─────────────────────────────────────────────
RABBITMQ_USER=careeros
RABBITMQ_PASSWORD=careeros123
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ─────────────────────────────────────────────
# MAILPIT (local SMTP for development)
# ─────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
# IMPORTANT: Change this to a 256-bit random secret in production!
JWT_SECRET=careeros-super-secret-key-change-in-production-256-bit-min-length
JWT_EXPIRATION=86400000

# ─────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
LOKI_PORT=3100
TEMPO_PORT=3200
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_OTLP_GRPC_PORT=4317

# ─────────────────────────────────────────────
# AWS (optional — leave blank for local dev)
# ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=careeros-profiles

# ─────────────────────────────────────────────
# AI AGENT
# ─────────────────────────────────────────────
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
